{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jekylhyde82/7282ALLSPARXPRIME/blob/main/tools/performance-lab/schema/evidence-manifest.schema.json",
  "title": "GENESIS Performance Lab Signed Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "revision",
    "created_at",
    "signer",
    "artifacts",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "benchmark_id": {
      "const": "GENESIS-PERFORMANCE-LAB-001"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signer_id",
        "role"
      ],
      "properties": {
        "signer_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "evidence-custodian",
            "independent-reviewer",
            "release-approver"
          ]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "public_key_sha256",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "public_key_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "value": {
          "type": "string",
          "minLength": 80,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    }
  }
}
