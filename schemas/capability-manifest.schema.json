{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allsparx.prime/schemas/capability-manifest.schema.json",
  "title": "ALLSPARX PRIME Capability Manifest",
  "description": "Strict metadata contract for a reusable capability. A manifest is declarative data and must never be treated as executable instructions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "capability_id",
    "display_name",
    "version",
    "release_channel",
    "description",
    "owner",
    "source",
    "license",
    "package",
    "interfaces",
    "dependencies",
    "runtime",
    "permissions",
    "data_handling",
    "verification",
    "security_review"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0.0"
    },
    "capability_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?:\\.[a-z0-9]+(?:[.-][a-z0-9]+)*)+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "release_channel": {
      "enum": [
        "experimental",
        "preview",
        "stable",
        "deprecated"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team"
      ],
      "properties": {
        "team": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "contact": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "path"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/@+-]+(?:/[A-Za-z0-9._@+-]+)*$"
        },
        "release": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx_expression",
        "attribution"
      ],
      "properties": {
        "spdx_expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "modifications": {
          "type": "string",
          "maxLength": 4000
        },
        "review_status": {
          "enum": [
            "approved",
            "restricted",
            "rejected",
            "unknown"
          ]
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "digest"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "key_id",
            "value"
          ],
          "properties": {
            "algorithm": {
              "enum": [
                "ed25519",
                "ecdsa-p256-sha256"
              ]
            },
            "key_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "contract"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,99}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "contract": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "version",
          "digest"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environments"
      ],
      "properties": {
        "environments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "enum": [
              "node",
              "cloudflare-workers",
              "browser",
              "deno",
              "bun",
              "python",
              "container"
            ]
          }
        },
        "minimum_versions": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "network_destinations"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "read:declared-input",
              "write:declared-output",
              "filesystem:read-package",
              "filesystem:write-workspace",
              "network:outbound",
              "process:spawn",
              "credentials:read",
              "data:export",
              "deployment:production"
            ]
          }
        },
        "network_destinations": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 50,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    },
    "data_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "retention"
      ],
      "properties": {
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "retention": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "personal_data": {
          "type": "boolean"
        },
        "secret_access": {
          "const": false
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_id",
        "status",
        "verified_at",
        "evidence"
      ],
      "properties": {
        "suite_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "enum": [
            "not-run",
            "passed",
            "failed",
            "blocked"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "reference"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "static-analysis",
                  "dependency-audit",
                  "license-review",
                  "unit",
                  "integration",
                  "regression",
                  "security",
                  "performance",
                  "sandbox-boundary"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "result_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "security_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "risk_tier"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "expired"
          ]
        },
        "risk_tier": {
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ]
        },
        "reviewer": {
          "type": "string",
          "maxLength": 160
        },
        "approval_reference": {
          "type": "string",
          "maxLength": 1000
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "changelog": {
      "type": "string",
      "maxLength": 10000
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deprecated"
      ],
      "properties": {
        "deprecated": {
          "type": "boolean"
        },
        "replacement": {
          "type": "string",
          "maxLength": 160
        },
        "reason": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatible_with_previous"
      ],
      "properties": {
        "compatible_with_previous": {
          "type": "boolean"
        },
        "known_good_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    }
  }
}
